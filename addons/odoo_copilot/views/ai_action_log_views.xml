<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue liste du journal des actions IA -->
    <record id="view_ai_action_log_list" model="ir.ui.view">
        <field name="name">ai.action.log.list</field>
        <field name="model">ai.action.log</field>
        <field name="arch" type="xml">
            <list string="Journal des actions IA" decoration-info="status == 'draft'" decoration-success="status == 'executed'" decoration-danger="status == 'rejected'" decoration-warning="status == 'approved'">
                <field name="create_date" string="Date"/>
                <field name="name" string="Résumé"/>
                <field name="agent" string="Agent"/>
                <field name="status" string="Statut" widget="badge"/>
                <field name="user_id" string="Utilisateur"/>
            </list>
        </field>
    </record>

    <!-- Vue formulaire du journal des actions IA -->
    <record id="view_ai_action_log_form" model="ir.ui.view">
        <field name="name">ai.action.log.form</field>
        <field name="model">ai.action.log</field>
        <field name="arch" type="xml">
            <form string="Détail de l'action IA">
                <sheet>
                    <group>
                        <group string="Informations générales">
                            <field name="name" string="Résumé"/>
                            <field name="agent" string="Agent"/>
                            <field name="status" string="Statut" widget="badge"/>
                            <field name="user_id" string="Utilisateur"/>
                            <field name="create_date" string="Date" readonly="1"/>
                        </group>
                    </group>
                    <group string="Contenu">
                        <field name="question" string="Question posée" colspan="2"/>
                        <field name="response" string="Réponse de l'agent" colspan="2"/>
                        <field name="draft_payload" string="Payload brouillon (JSON)" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action fenêtre pour le journal -->
    <record id="action_ai_action_log" model="ir.actions.act_window">
        <field name="name">Journal des actions IA</field>
        <field name="res_model">ai.action.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Aucune action IA enregistrée pour l'instant.
            </p>
            <p>
                Les actions proposées par l'assistant IA apparaîtront ici pour validation.
            </p>
        </field>
    </record>
</odoo>
